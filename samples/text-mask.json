{
  "Version": 1,
  "ContinueOnError": true,
  "Verbose": true,
  "Rules": [
    {
      "Name": "Native background masks for all supported text",
      "Type": "TextMask",
      "Enabled": true,
      "Filter": {
        "Scope": "ModelAndLayouts"
      },
      "Action": {
        "MaskMode": "Auto",
        "MaskOnlyWhenOccluded": false,
        "MaskMinOccludedRatio": 0.05,
        "MaskPaddingRatio": 0.15,
        "MaskTextBox": "Auto",
        "MaskBringTextToFront": true,
        "MaskLayer": "_MASK",
        "MaskLayerPlottable": true,
        "MaskRebuildText": true,
        "MaskInsideBlocks": true,
        "MaskSendHatchToBack": true,
        "DimensionTextMode": "All",
        "DimensionMaskMode": "Native"
      }
    }
  ]
}
