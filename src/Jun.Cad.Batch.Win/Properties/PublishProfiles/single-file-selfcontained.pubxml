<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布（自包含版，约 73 MB）
  自带 .NET 8 运行时，目标机什么都不用装。

  用法： dotnet publish src/Jun.Cad.Batch.Win -p:PublishProfile=single-file-selfcontained
  产物： src/Jun.Cad.Batch.Win/bin/publish/single-file-sc/Jun.Cad.Batch.exe

  为什么这么大：WinForms 依赖整个 Windows Desktop 运行时（含 WPF 的原生库），
  开 EnableCompressionInSingleFile 后从 ~150 MB 压到 ~73 MB。
  不要试图用 PublishTrimmed 缩小——WinForms 不支持裁剪，SDK 会直接报错。

  IncludeNativeLibrariesForSelfExtract 也必须开：
  否则 D3DCompiler_47_cor3.dll / wpfgfx_cor3.dll 等 5 个原生库会甩在 exe 旁边，
  单文件就名不副实了（实测未开时确实甩出 5 个 dll）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 被引用工程（Core）的 .pdb 会跟着复制过来，这一项把它挡掉，否则"就一个文件"不成立 -->
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>bin\publish\single-file-sc\</PublishDir>
  </PropertyGroup>

  <!--
    被引用工程（Core）的 .pdb 会跟着复制进发布目录，光靠 CopyOutputSymbolsToPublishDirectory
    在部分 SDK 组合下挡不住。这里在 Publish 之后直接删掉，保证发布目录里只剩一个 exe。
  -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <LeftoverSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(LeftoverSymbols)" />
  </Target>
</Project>
