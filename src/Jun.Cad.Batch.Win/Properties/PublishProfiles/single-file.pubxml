<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布（框架依赖版，约 2.8 MB）
  目标机需要装 .NET 8 Desktop Runtime（x64）。

  用法： dotnet publish src/Jun.Cad.Batch.Win -p:PublishProfile=single-file
  产物： src/Jun.Cad.Batch.Win/bin/publish/single-file/Jun.Cad.Batch.exe （就这一个文件）

  关键属性说明：
    PublishSingleFile                 打包成单个 exe
    IncludeAllContentForSelfExtract   **必须**。Resources 下的 .pat/.lin 是内容文件，
                                      不加这个只会打包程序集，资源仍然散落在 exe 旁边。
                                      加上后启动时会把全部文件解到 %TEMP%\.net\<程序名>\<hash>\，
                                      AppContext.BaseDirectory 指向那个目录，现有的
                                      "按目录找 acadiso.pat" 逻辑不用改一行代码。
    DebugType=None                    不加会多出 .pdb，破坏"就一个文件"
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 被引用工程（Core）的 .pdb 会跟着复制过来，这一项把它挡掉，否则"就一个文件"不成立 -->
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>bin\publish\single-file\</PublishDir>
  </PropertyGroup>

  <!--
    被引用工程（Core）的 .pdb 会跟着复制进发布目录，光靠 CopyOutputSymbolsToPublishDirectory
    在部分 SDK 组合下挡不住。这里在 Publish 之后直接删掉，保证发布目录里只剩一个 exe。
  -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <LeftoverSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(LeftoverSymbols)" />
  </Target>
</Project>
